# Copy to .env (gitignored). Values here are local-dev defaults.
MONGO_URL=mongodb://localhost:27017
DB_NAME=kedbyte
CORS_ORIGINS=http://localhost:3001

# Email (optional — sending is skipped when RESEND_API_KEY is unset)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
CONTACT_RECIPIENT_EMAIL=

# Enables GET /api/contacts with an x-admin-token header; unset = disabled
ADMIN_TOKEN=

# Rate-limit bypass for the local e2e suite. NEVER set in production.
E2E_BYPASS_TOKEN=kedbyte-e2e-local
